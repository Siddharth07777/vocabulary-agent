{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/generate.js": { "maxDuration": 60 },
    "api/cron/recover.js": { "maxDuration": 30 },
    "api/words.js": { "maxDuration": 10 }
  },
  "crons": [
    { "path": "/api/cron/recover", "schedule": "0 0 * * *" }
  ],
  "rewrites": [
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/app.js", "destination": "/web/app.js" }
  ]
}
